# 이 파일을 복사해 .env를 만들고 값을 바꾼다:  cp .env.example .env   (Windows: copy .env.example .env)
# .env는 절대 Git에 올리지 않는다 (.gitignore에 포함)

# MySQL
DB_URL=jdbc:mysql://localhost:3307/myrecipe?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=myrecipe
DB_PASSWORD=change-me-db
DB_ROOT_PASSWORD=change-me-db-root

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=change-me-redis

# 사진 저장소: AWS S3 (5단계에서 AWS 설정 후 채운다. 절차는 INTEGRATION.md 4장)
#   ACCESS_KEY/SECRET_KEY: 이 버킷만 다룰 수 있는 IAM 사용자 키. 절대 Git·채팅·스크린샷에 노출하지 않는다
#   BUCKET: S3 버킷 이름은 전 세계에서 하나뿐이어야 한다 (예: myrecipe-images-본인아이디)
STORAGE_REGION=ap-northeast-2
STORAGE_BUCKET=change-me-bucket-name
STORAGE_PUBLIC_URL=https://change-me.cloudfront.net
STORAGE_ACCESS_KEY=change-me-aws-access-key
STORAGE_SECRET_KEY=change-me-aws-secret-key

# JWT (1단계부터 사용) - JWT_SECRET은 32자 이상 임의 문자열
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_ACCESS_EXPIRATION_SECONDS=1800
JWT_REFRESH_EXPIRATION_SECONDS=1209600
COOKIE_SECURE=false
